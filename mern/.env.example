# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Optional override for the existing Supabase Edge Function used for nearby attractions.
# Defaults to NEXT_PUBLIC_SUPABASE_URL + /functions/v1/travel-attractions.
TRAVEL_ATTRACTIONS_URL=

# Do not add a service-role key to NEXT_PUBLIC_* variables or browser code.
