# Local development only. Never commit real secrets.
PORT=3001
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Use the existing Supabase project URL and publishable/anon key in the client
# environment only. Never place a service_role key in VITE_* variables.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
